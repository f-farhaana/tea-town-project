# Browser-safe settings only. Leave the two Supabase values empty to run the labelled DEMO mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# demo | production   (production = real database, demo logins disabled)
VITE_APP_MODE=demo
VITE_PUBLIC_WEBSITE_URL=https://tea-town.vercel.app
# Live address of this app, used in QR codes (defaults to the current site address)
VITE_APP_URL=
# Never put the Supabase service-role key or database password in this app or in any VITE_ variable.
